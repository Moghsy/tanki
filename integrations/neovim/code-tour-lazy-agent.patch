+++ b/lua/code-tour/lazy.lua
@@ -0,0 +1,88 @@
+-- A reader-owned Claude pane, created only by an explicit explanation request.
+local M = {}
+local entries = {}
+local function request(opts, args, callback, timeout)
+  local command = { vim.env.HERDR_BIN_PATH or "herdr", "--session", opts.session }
+  vim.list_extend(command, args)
+  local ok, failure = pcall(vim.system, command, {text=true, timeout=timeout or 10000}, vim.schedule_wrap(function(result)
+    local parsed, response = pcall(vim.json.decode, result.stdout or "")
+    if not parsed then parsed, response = pcall(vim.json.decode, result.stderr or "") end
+    if result.code ~= 0 or not parsed or type(response) ~= "table" or response.error then
+      local err = parsed and type(response) == "table" and response.error and response.error.message
+      callback(nil, err or result.stderr or "Herdr request failed")
+    else callback(response.result or response) end
+  end))
+  if not ok then callback(nil, tostring(failure)) end
+end
+function M.ensure(opts, callback)
+  if opts.kind ~= "claude" or not opts.session or not opts.pane_id then
+    callback(false, "Lazy Claude needs Neovim running in a Herdr pane")
+    return
+  end
+  local key = opts.session .. "\n" .. opts.pane_id .. "\n" .. opts.root
+  local entry = entries[key]
+  if not entry then entry = { waiters={} }; entries[key] = entry end
+  entry.waiters[#entry.waiters + 1] = callback
+  if entry.busy then return end
+  entry.busy = true
+  local function finish(origin, error)
+    entry.busy = false
+    if origin then entry.origin = origin end
+    local waiters = entry.waiters
+    entry.waiters = {}
+    for _, waiter in ipairs(waiters) do waiter(origin ~= nil, origin or error) end
+  end
+  local resolve
+  resolve = function(start_if_missing)
+    request(opts, {"agent", "list"}, function(result, error)
+      if not result then finish(nil, error); return end
+      local live
+      for _, agent in ipairs(result.agents or {}) do
+        if agent.pane_id == entry.pane and agent.agent == "claude" then live = agent; break end
+      end
+      if not live then
+        if not start_if_missing then finish(nil, "Claude did not become ready in pane " .. entry.pane .. "; inspect it before retrying"); return end
+        entry.origin = nil
+        request(opts, {"agent", "start", "tanki-" .. vim.fn.sha256(key):sub(1, 12), "--kind", "claude", "--pane", entry.pane, "--timeout", "30000"}, function(started, start_error)
+          if not started then
+            finish(nil, "Claude startup needs attention in pane " .. entry.pane .. ": " .. tostring(start_error))
+            return
+          end
+          resolve(false)
+        end, 35000)
+        return
+      end
+      if live.agent_status ~= "idle" and live.agent_status ~= "done" then
+        finish(nil, "Claude is " .. tostring(live.agent_status) .. " in pane " .. entry.pane .. "; finish its startup/input and retry")
+        return
+      end
+      request(opts, {"pane", "process-info", "--pane", entry.pane}, function(info, process_error)
+        if not info then finish(nil, process_error); return end
+        local ids = {}
+        for _, process in ipairs((info.process_info or {}).foreground_processes or {}) do ids[#ids + 1] = process.pid end
+        if #ids == 0 then finish(nil, "Claude foreground process is missing; inspect " .. entry.pane); return end
+        if entry.origin then
+          local same = false
+          for _, pid in ipairs(ids) do
+            if vim.tbl_contains(entry.origin.process_ids, pid) then same = true end
+          end
+          if not same then finish(nil, "Reader Claude pane was replaced; open a new reader to create a new connection"); return end
+        end
+        finish({session=opts.session, pane_id=entry.pane, tab_id=live.tab_id, agent="claude", process_ids=ids,
+          agent_session=live.agent_session and live.agent_session.value})
+      end)
+    end)
+  end
+  if entry.pane then resolve(true); return end
+  local args = {"pane", "split", "--pane", opts.pane_id, "--direction", "right", "--cwd", opts.root, "--no-focus"}
+  for _, name in ipairs({"NVIM_APPNAME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"}) do
+    if vim.env[name] then vim.list_extend(args, {"--env", name .. "=" .. vim.env[name]}) end
+  end
+  request(opts, args, function(result, error)
+    if not result then finish(nil, "Could not create Claude pane: " .. tostring(error)); return end
+    entry.pane = result.pane and result.pane.pane_id
+    if not entry.pane then finish(nil, "Herdr did not return a new pane ID"); return end
+    resolve(true)
+  end)
+end
+return M
